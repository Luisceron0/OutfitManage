# En desarrollo local, deja vacío para usar el proxy de rewrites de Next.js hacia el backend.
NEXT_PUBLIC_API_URL=

# URL interna servidor-a-servidor (SSR / rewrites). En producción, la URL real del backend.
INTERNAL_BACKEND_URL="http://localhost:3000"

# Nombre de la tienda, usado en el mensaje prellenado de WhatsApp del lado del cliente.
NEXT_PUBLIC_TIENDA_NOMBRE="Tienda360"
