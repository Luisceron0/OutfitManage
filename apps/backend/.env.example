# Configuración General del Servidor
PORT=3000
NODE_ENV=development

# Configuración de Base de Datos PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tienda360_dev?schema=public"

# Configuración de JWT (RS256 - Par de Claves RSA)
# Reemplazar con las claves en formato PEM base64 o multilinea
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Seguridad y Dominios Permitidos (Allowlist)
CORS_ORIGIN="http://localhost:3001,http://localhost:3002"
ALLOWED_HOSTS="localhost,127.0.0.1"

# Almacenamiento de Imágenes (Cloudinary - ADR-008)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
